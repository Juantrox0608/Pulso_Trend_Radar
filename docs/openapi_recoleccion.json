{
  "openapi": "3.1.0",
  "info": {
    "title": "Radar · Recolección",
    "version": "0.1"
  },
  "paths": {
    "/salud": {
      "get": {
        "summary": "Salud",
        "operationId": "salud_salud_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/busquedas": {
      "post": {
        "summary": "Iniciar",
        "operationId": "iniciar_busquedas_post",
