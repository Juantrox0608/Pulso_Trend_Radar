COLLECTOR_MODE=mock
# Provisional: POST to this exact URL with filters; returns metadata + statistics.
# Set COLLECTOR_MODE=http only after agreeing the contract with the collector team.
COLLECTOR_URL=
COLLECTOR_TOKEN=
COLLECTOR_TIMEOUT_SECONDS=10
AI_ANALYZE_URL=http://127.0.0.1:8001/analyze
AI_TIMEOUT_SECONDS=45
RESEARCH_TIMEOUT_SECONDS=60
# Optional browser frontend origins, JSON list. Postman does not require CORS.
CORS_ORIGINS=[]
